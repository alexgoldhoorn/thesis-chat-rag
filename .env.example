# Postgres (pgvector). The app connects as the read-only role; ingestion as the
# ingest role. Roles and passwords are created by db/init.sh on first start.
DATABASE_URL=postgres://chat_ro:change-me@localhost:5433/thesis
INGEST_DATABASE_URL=postgres://ingest:change-me@localhost:5433/thesis

# Anthropic — from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional, defaults to claude-opus-5-5
# CHAT_MODEL=claude-sonnet-5-5
# Optional, max answers per day across all visitors (default 200)
# DAILY_ANSWER_LIMIT=200

# Google AI (embeddings) — from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
